# Local isolated cluster started by `npm run db:up` (scripts/db-local.sh)
DATABASE_URL=postgres://mutinai@127.0.0.1:54329/mutinai
TEST_DATABASE_URL=postgres://mutinai@127.0.0.1:54329/mutinai_test

# Opaque session tokens are hashed with this secret before storage. Change in any shared environment.
SESSION_SECRET=dev-only-change-me-0123456789abcdef

# Enables the development sign-in page that lists seeded accounts. Never enable in production.
MUTINAI_DEV_LOGIN=1

# Local filesystem object store (raw ingestion payloads). Relative to repo root.
OBJECT_STORE_DIR=.data/objects

# ── Public deployment (all optional; see docs/deployment.md) ──
# Canonical public origin for absolute URLs. Falls back to the host-provided URL (RENDER_EXTERNAL_URL), then localhost.
# MUTINAI_SITE_URL=https://mutinai.com
# Search engines are told not to index (noindex) unless this is 1. Read at build time for response headers.
# MUTINAI_ALLOW_INDEXING=0

# ── Live ingestion (worker / cron only; never needed by the web service). See docs/live-ingestion.md ──
# Optional. Raises Hugging Face Hub limits from 500 to 1,000 requests per 5 minutes. A fine-grained read token.
# HUGGINGFACE_TOKEN=
# Strongly recommended for scheduled runs. Raises GitHub from 60 to 5,000 requests/hour. Fine-grained, public read-only.
# GITHUB_TOKEN=
# Live sources the `scheduled` command runs: huggingface,github,feeds,arxiv. Empty = none.
# MUTINAI_LIVE_SOURCES=
# Maximum items per source per scheduled run (default 300).
# MUTINAI_INGEST_LIMIT=300
# Identifies Mutinai to upstream APIs. Include a contact URL or address.
# MUTINAI_USER_AGENT=Mutinai-Ingest/0.1 (+https://mutinai.com)

# ── AI enrichment (disabled unless set; no provider is bundled). See docs/ai-enrichment.md ──
# MUTINAI_ENRICHMENT_PROVIDER=
